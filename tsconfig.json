{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "jsx": "react-native",
    "strict": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true, // Skips type checks for libraries
    "baseUrl": ".",
    "paths": {
      "@env": ["node_modules/@types/react-native-dotenv"]
    },
    "types": ["react"],
    
  },
  "exclude": [
    "node_modules", // Excludes node_modules from type checking
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "supabase/functions",
    "_to_delete"
  ]
}
