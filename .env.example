EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_your_key

# Temporary legacy configuration while the Firebase data layer is migrated.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Server-only secrets such as OPENAI_API_KEY and Supabase secret/service-role
# keys must never be included in the mobile app environment.

# RevenueCat public SDK keys. These are safe to commit to a build — they are
# app-scoped and write-only. The secret key (sk_...) and the webhook secret are
# server-side only and must never appear here.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_apple_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_google_key

# Optional: RevenueCat Test Store, which simulates purchases without App Store
# Connect. Requires react-native-purchases 9.5.4+ (this app is on 8.12.0, so it
# is inert until that upgrade) and is only ever read in a __DEV__ build.
# EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_your_test_store_key
# EXPO_PUBLIC_REVENUECAT_USE_TEST_STORE=1
