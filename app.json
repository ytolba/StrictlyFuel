{
  "expo": {
    "name": "StrictlyFuel",
    "slug": "strictlyfuel",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#F2EAD7",
      "resizeMode": "contain"
    },
    "scheme": "strictlyfuel",
    "newArchEnabled": true,
    "android": {
      "package": "com.strictlyfuel.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1D3B2A"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.strictlyfuel.app",
      "buildNumber": "10",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "StrictlyFuel uses the camera to photograph your meal or a product label so it can estimate the nutrition.",
        "NSPhotoLibraryUsageDescription": "StrictlyFuel needs access to your photos so you can pick an existing meal photo to analyse.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "bundleShortVersion": "1.0.1"
          }
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "StrictlyFuel uses the camera to photograph your meal or a product label so it can estimate the nutrition."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "StrictlyFuel needs access to your photos so you can pick an existing meal photo to analyse.",
          "cameraPermission": "StrictlyFuel uses the camera to photograph your meal or a product label so it can estimate the nutrition."
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "4f83705d-fda6-48c9-80ae-201f5646bf31"
      }
    },
    "owner": "sulahmad"
  }
}
